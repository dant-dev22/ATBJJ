# Archivo de ejemplo de variables de entorno del front (Next.js).
# Copiar a .env.local (o .env) y ajustar los valores. El archivo real NUNCA se versiona.

# --- API ---
# URL base de la API. Las variables NEXT_PUBLIC_* se "hornean" en tiempo de build.
# Local: http://localhost:5000 · Producción: /api (proxy de nginx hacia el puerto 5000).
NEXT_PUBLIC_API_URL=/api

# --- Sitio ---
# URL pública del sitio (metadata / canonical). Producción: https://torneoaztlan.com
NEXT_PUBLIC_SITE_URL=https://torneoaztlan.com

# --- Admin (/admin) ---
# Usuario del panel admin. Obligatoria para habilitar el login de /admin.
ADMIN_USER=
# Contraseña del panel admin. Obligatoria.
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión de /admin (mínimo 16 caracteres). Obligatoria.
ADMIN_SESSION_SECRET=
